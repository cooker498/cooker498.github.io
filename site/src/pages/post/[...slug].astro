---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postSlug } from '../../lib/post-url';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content, headings } = await render(post);

type TocItem = { depth: number; slug: string; text: string };

function decodeHeading(value: string) {
  return value
    .replace(/<[^>]+>/g, '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

function headingsFromHtml(body: string): TocItem[] {
  const items: TocItem[] = [];
  for (const match of body.matchAll(/<h([23])\b([^>]*)>([\s\S]*?)<\/h\1>/gi)) {
    const slug = match[2]?.match(/\bid=["']([^"']+)["']/i)?.[1];
    const text = decodeHeading(match[3] ?? '');
    if (!slug || !text) continue;
    items.push({ depth: Number(match[1]), slug, text });
  }
  return items;
}

const markdownToc = headings.filter((heading) => heading.depth <= 3);
const toc = markdownToc.length > 0 ? markdownToc : headingsFromHtml(post.body ?? '');
const date = post.data.date.toLocaleDateString('zh-CN', {
  timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article-frame">
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        <time datetime={post.data.date.toISOString()}>{date}</time>
        <span aria-hidden="true"> · </span>
        <a href={`/categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a>
        {post.data.tags.length > 0 && (
          <>
            <span aria-hidden="true"> · </span>
            <span class="tag-row">
              {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
            </span>
          </>
        )}
      </div>
      {toc.length > 2 && (
        <details class="toc">
          <summary>
            <span>本文目录</span>
            <span class="toc-when-closed">展开</span>
            <span class="toc-when-open">收起</span>
          </summary>
          <nav aria-label="文章目录">
            <ol>
              {toc.map((heading) => (
                <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </nav>
        </details>
      )}
    </header>
    <div class="article-content"><Content /></div>
    <footer class="article-footer">
      <span>最后更新：{(post.data.updated ?? post.data.date).toISOString().slice(0, 10)}</span>
      <a href="/post/">返回归档</a>
    </footer>
  </article>
</BaseLayout>
