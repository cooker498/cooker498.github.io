---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const topicCount = new Set(posts.map((post) => post.data.category)).size;

const filters = [
  { id: 'all', label: '全部', count: posts.length },
  { id: 'systems', label: '系统', count: 3 },
  { id: 'algorithms', label: '算法', count: 1 },
  { id: 'agent', label: 'AI Agent', count: 1 },
  { id: 'mobile', label: '移动开发', count: 3 },
  { id: '整理', label: '正在整理', count: 1 },
];

const projects = [
  {
    topic: 'agent', tab: 'AI Agent', tabTone: 'blue', number: '#001',
    title: 'AI Agent × 交易研究',
    description: '把市场信息、研究假设和验证过程连接成可追溯的 Agent 工作流。',
    tags: ['AI Agent', 'Research', 'Evaluation'], date: '研究中', kind: '研究',
  },
  {
    topic: 'algorithms', tab: '算法', tabTone: 'yellow', number: '#002',
    title: 'Algorithms Learning',
    description: '算法与数据结构的长期练习仓库，用实现形成稳定的解题直觉。',
    tags: ['Algorithms', 'Data Structure'], date: '持续学习', kind: '项目',
    href: 'https://github.com/cooker498/Algorithms_learning',
  },
  {
    topic: 'systems', tab: '分布式系统', tabTone: 'slate', number: '#003',
    title: '数据密集型应用笔记',
    description: '从理论到实践，记录我阅读《Designing Data-Intensive Applications》的思考。',
    tags: ['DDIA', '存储', '一致性'], date: '阅读中', kind: '笔记',
    href: '/post/ddia-reliable-scalable-maintainable/',
  },
  {
    topic: 'mobile', tab: '移动开发', tabTone: 'coral', number: '#004',
    title: 'Android 工程实践',
    description: '保留移动端集成、发布和工具链实践，也保留技术选择随时间演进的痕迹。',
    tags: ['Android', 'Ionic', '工具链'], date: '历史笔记', kind: '项目',
    href: '/categories/APP%E5%BC%80%E5%8F%91/',
  },
  {
    topic: 'systems', tab: '系统', tabTone: 'green', number: '#005',
    title: 'cooker498.github.io',
    description: '从旧版 Hugo 博客演进而来的个人知识站，记录学习与构建本身。',
    tags: ['Astro', 'GitHub Pages'], date: '正在重构', kind: '项目',
    href: 'https://github.com/cooker498/cooker498.github.io',
  },
  {
    topic: '整理', tab: '正在整理', tabTone: 'violet', number: '#006',
    title: 'Agent 工具链笔记',
    description: '把工具调用、上下文组织与评估方法整理成可以复用的工作手册。',
    tags: ['Workflow', 'Notes'], date: '待整理', kind: '笔记',
  },
];

const topicFor = (category: string) =>
  category === 'APP开发' ? 'mobile' : category === '架构设计' ? 'systems' : '整理';
---

<BaseLayout description="cooker498 的知识卡片仓：持续学习、持续构建。">
  <div class="home">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">KNOWLEDGE MAKES A BETTER DEVELOPER</p>
        <h1>Hi, cooker498</h1>
        <p class="hero-nameplate">cooker498 的知识卡片仓</p>
        <p class="hero-lead">持续学习 / 持续构建</p>
        <p class="hero-kicker">代码 · 思考 · 构建更好的系统</p>
        <p class="hero-text">这里记录我在 AI Agents、量化交易、算法、分布式系统、Hugo 和 Android 等领域的学习笔记与实践项目。把零散的知识整理成可复用的卡片，让技术成为长期复利。</p>
        <div class="social-row">
          <a class="icon-link" href="/rss.xml" aria-label="RSS 订阅">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="6" cy="18" r="1.4" fill="currentColor" stroke="none"></circle>
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 5a15 15 0 0 1 15 15"></path>
            </svg>
          </a>
          <a class="icon-link" href="https://github.com/cooker498" aria-label="在 GitHub 上找到我">
            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.5 7.5 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          </a>
          <a href="/about/">关于我</a>
          <a href="/post/">全部笔记</a>
        </div>
      </div>
      <div class="hero-visual">
        <aside class="hero-card" aria-label="记录思考，也记录成长。">
          <p class="hero-note">记录思考，<br />也记录成长。</p>
          <p class="hero-motto">Better Code<br />Clearer Thinking<br />A Fuller Life</p>
          <p class="hero-id"><strong>cooker498</strong><span>Build a sharper me.</span></p>
        </aside>
      </div>
    </section>

    <div class="section-rule"><span>知识索引</span></div>
    <section class="index-block" aria-label="知识索引">
      <p class="eyebrow">KNOWLEDGE INDEX</p>
      <h2>索引</h2>
      <div class="topic-nav" role="group" aria-label="按主题筛选">
        {filters.map((filter) => (
          <button class:list={['topic-filter', { active: filter.id === 'all' }]} type="button" data-topic-filter={filter.id} aria-pressed={filter.id === 'all' ? 'true' : 'false'}>
            <span>{filter.label}</span>
            <small>({filter.count})</small>
          </button>
        ))}
      </div>
      <nav class="text-links" aria-label="其他页面">
        <a href="/about/">关于我</a>
        <a href="/post/">全部笔记</a>
        <a href="/rss.xml">RSS 订阅</a>
        <a href="https://github.com/cooker498">在 GitHub 上找到我</a>
      </nav>
      <blockquote class="side-quote">“技术让世界更大，而持续学习让自己更自由。”<cite>— cooker498</cite></blockquote>
      <p class="since"><strong>2018 — 现在</strong><span>一个热爱构建的软件工程师</span></p>
    </section>

    <section class="archive-stats" aria-label="知识仓概览">
      <div><strong>{projects.length}</strong><span>知识卡片<small>笔记 · 项目 · 思考</small></span></div>
      <div><strong>{topicCount}</strong><span>技术领域<small>从系统到实践</small></span></div>
      <div><strong>2018 — 现在</strong><span>持续记录<small>技术、生活与成长</small></span></div>
      <div class="stat-motto"><span>“持续学习<br />持续构建”</span><small>— cooker498</small></div>
    </section>

    <div class="section-rule"><span>精选卡片</span></div>
    <section class="card-section" aria-labelledby="featured-title">
      <div class="section-head">
        <div>
          <h2 id="featured-title">精选卡片</h2>
          <p>一些正在构建或已经完成的项目，记录从 0 到 1 的过程。</p>
        </div>
      </div>
      <div class="card-grid">
        {projects.map((project) => (
          <a class:list={['lift-card', 'project-card', 'filterable-card', 'tab-' + project.tabTone]} data-topic={project.topic} href={project.href ?? '#'} aria-label={project.title + '：' + project.description}>
            <span class="lift-back" aria-hidden="true"></span>
            <span class="lift-front" aria-hidden="true"></span>
            <span class="lift-face">
              <span class="project-kicker"><span class="file-tab">{project.tab}</span><span class="card-number">{project.number}</span></span>
              <h3>{project.title}<svg class="arrow" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></h3>
              <p>{project.description}</p>
              <ul>{project.tags.map((tag) => <li>{tag}</li>)}</ul>
              <span class="project-meta"><time>{project.date}</time><span>{project.kind}</span></span>
            </span>
          </a>
        ))}
      </div>
      <p class="section-more"><a class="pill" href="https://github.com/cooker498">查看更多</a></p>
    </section>

    <div class="section-rule"><span>最近笔记</span></div>
    <section class="notes-section" aria-labelledby="notes-title">
      <div class="section-head">
        <div>
          <h2 id="notes-title">最近笔记</h2>
          <p>最新的思考、学习记录与问题总结。</p>
        </div>
      </div>
      <div class="notes-layout">
        <div class="post-stack">
          {posts.slice(0, 5).map((post) => <PostCard post={post} topic={topicFor(post.data.category)} />)}
        </div>
        <aside class="currently-card" aria-label="正在学习">
          <p class="eyebrow">CURRENTLY LEARNING</p>
          <h3>Designing Data-Intensive Applications</h3>
          <p>从可靠性、可扩展性和可维护性出发，建立对现代数据系统的系统性认知。</p>
          <div class="reading-status"><span class="reading-check" aria-hidden="true">✓</span><span>正在阅读：第一章<small>可靠、可扩展与可维护的应用</small></span></div>
          <a href="/post/ddia-reliable-scalable-maintainable/">打开笔记</a>
        </aside>
      </div>
      <p class="section-more"><a class="pill" href="/post/">查看更多</a></p>
    </section>

    <blockquote class="closing-quote">
      “好的工程师不仅解决问题，还会积累和分享。”
      <cite>— cooker498</cite>
      <span class="mantra">THINK DEEPLY<br />BUILD PRACTICALLY<br />SHARE OPENLY</span>
    </blockquote>
  </div>

  <script>
    const topicButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-topic-filter]'));
    const filterableCards = Array.from(document.querySelectorAll<HTMLElement>('.filterable-card'));

    for (const button of topicButtons) {
      button.addEventListener('click', () => {
        const selected = button.dataset.topicFilter ?? 'all';
        for (const candidate of topicButtons) {
          const active = candidate === button;
          candidate.classList.toggle('active', active);
          candidate.setAttribute('aria-pressed', String(active));
        }
        for (const card of filterableCards) {
          card.hidden = selected !== 'all' && card.dataset.topic !== selected;
        }
      });
    }
  </script>
</BaseLayout>
